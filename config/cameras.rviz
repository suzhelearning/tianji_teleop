Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 249
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Top RGB
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cameras/top/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Left Wrist RGB
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cameras/left_wrist/color/image_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Right Wrist RGB
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cameras/right_wrist/color/image_raw
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.5
          Class: rviz_default_plugins/CameraInfo
          Color: 85; 255; 255
          Edge color: 125; 125; 125
          Enabled: true
          Far clip: 1
          Name: Top CameraInfo
          Not show side polygons: true
          Show edges: true
          Show polygons: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /cameras/top/color/camera_info
          Value: true
        - Alpha: 0.5
          Class: rviz_default_plugins/CameraInfo
          Color: 85; 255; 255
          Edge color: 125; 125; 125
          Enabled: true
          Far clip: 1
          Name: Left Wrist CameraInfo
          Not show side polygons: true
          Show edges: true
          Show polygons: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /cameras/left_wrist/color/camera_info
          Value: true
        - Alpha: 0.5
          Class: rviz_default_plugins/CameraInfo
          Color: 85; 255; 255
          Edge color: 125; 125; 125
          Enabled: true
          Far clip: 1
          Name: Right Wrist CameraInfo
          Not show side polygons: true
          Show edges: true
          Show polygons: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /cameras/right_wrist/color/camera_info
          Value: true
      Enabled: false
      Name: Driver CameraInfo (requires calibrated TF)
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: ""
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.440451979637146
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7853981852531433
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.7853981852531433
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1011
  Hide Left Dock: false
  Hide Right Dock: false
  Left Wrist RGB:
    collapsed: false
  QMainWindow State: 
  Right Wrist RGB:
    collapsed: false
  Top RGB:
    collapsed: false
  Views:
    collapsed: false
  Width: 1854
  X: 66
  Y: 32
