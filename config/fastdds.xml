<?xml version="1.0" encoding="UTF-8"?>
<!-- Same-host transport: 128 MiB per participant, 4 MiB messages accommodate
     schema-v1 1280x720 RGB8 without UDP fragmentation. Not zero-copy. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>tianji_shm</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <maxMessageSize>4194304</maxMessageSize>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="tianji_local" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>tianji_shm</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
