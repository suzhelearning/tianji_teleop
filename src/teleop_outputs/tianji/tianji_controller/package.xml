<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tianji_controller</name>
  <version>0.3.0</version>
  <description>
    Arm executor, safety gates and native controller. Also hosts the native
    CMake projects (the DLS/SharedRoot core with Ruckig) and the device
    feedback publisher. It owns no ROS services that can enable motion.
  </description>
  <maintainer email="ops@example.com">Tianji operators</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tianji_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tianji_description</exec_depend>
  <exec_depend>wuji_controller</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
