<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>data_collector</name>
  <version>0.3.0</version>
  <description>
    Schema-v1 episode collector. Subscribes to the executor's measured feedback
    and the official camera driver, and exposes recording commands and status.
    Connects to no hardware and holds no motion authority.
  </description>
  <maintainer email="ops@example.com">Tianji operators</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tianji_interfaces</exec_depend>
  <exec_depend>tianji_controller</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>realsense2_camera_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-h5py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
