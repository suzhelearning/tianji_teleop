<?xml version="1.0"?>
<package format="3">
  <name>fisheye_camera</name>
  <version>0.1.0</version>
  <description>C++ ROS2 node for USB fisheye camera capture via V4L2 with CompressedImage publishing</description>
  <maintainer email="1107587798@QQ.COM">LJM</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
