<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tianji_cameras</name>
  <version>0.3.0</version>
  <description>
    RealSense camera side of the workspace: profile preflight, the launch that
    starts the official realsense2_camera driver per role, the readiness monitor
    and read-only RGB preview/PICO H.264 streaming. Never opens a pipeline itself.
  </description>
  <maintainer email="ops@example.com">Tianji operators</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tianji_interfaces</exec_depend>
  <exec_depend>data_collector</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>realsense2_camera_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
