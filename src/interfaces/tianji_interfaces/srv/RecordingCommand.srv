# Recording control. This service has no hardware authority whatsoever:
# it can only start, save, discard or abort *recording*. `abort` reduces
# recording state and never commands the robot.

# One of: start, save, discard, abort.
string command

# Session the operator believes is active. start/save/discard must match the
# newest healthy ExecutorState; abort is accepted whenever recording.
string session_id

# Phase revision the operator believes is active; checked the same way.
uint64 phase_revision
---
# True when the command was enqueued. False for a repeated, unknown or
# inapplicable request — there is no automatic retry.
bool accepted

# Collector state at the moment the request was answered.
string state

# Reason, and for rejected requests the specific mismatch.
string message
