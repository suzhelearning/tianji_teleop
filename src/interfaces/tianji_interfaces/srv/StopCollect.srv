# Recording only; a stop is bound to one specific executor session and episode.
# Reusing a UUID with the identical request returns the original operation result.
string request_id
string session_id
uint64 phase_revision
string episode_id
# Operator s: save=true. Operator d: save=false, abort=false.
bool save
# Fault/teardown: preserve an unsaved partial instead of publishing success or deleting it.
# save=true and abort=true is invalid. This flag grants no motion authority.
bool abort
# Executor key receipt CLOCK_MONOTONIC time. Zero keeps legacy stop-at-service behavior.
# A successful save contains no sample later than this cutoff, including queued samples.
int64 cutoff_monotonic_ns
---
# True only after the requested writer finalization/deletion has completed.
bool success
string request_id
string session_id
string episode_id
string state
string saved_path
string message
