<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mocap_policy_runtime</name>
  <version>0.3.0</version>
  <description>
    Motive/mocap trajectory replay and Regrind reference-conditioned policy
    inference. Importing the package opens no device: replay is read-only and
    real-device execution goes through tianji_controller's motion gates.
  </description>
  <maintainer email="ops@example.com">Tianji operators</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>tianji_interfaces</exec_depend>
  <exec_depend>tianji_description</exec_depend>
  <exec_depend>tianji_controller</exec_depend>
  <exec_depend>simulation</exec_depend>
  <exec_depend>wuji_retargeting</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-h5py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
