<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manus_bridge</name>
  <version>0.3.0</version>
  <description>
    Manus Metaglove Pro input: the Integrated SDK collector launcher, the
    per-user .mcal calibration profiles and the /hand_input publisher that
    feeds the Wuji Hand2 retargeter. Input only; it never commands hardware.
  </description>
  <maintainer email="ops@example.com">Tianji operators</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tianji_interfaces</exec_depend>
  <!-- The default ROS decoder and the isolated manus worker share the
       existing Wuji bridge implementation. Native imports occur only in the
       worker's own environment, never through a foreign Python path. -->
  <exec_depend>wuji_retargeting</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
