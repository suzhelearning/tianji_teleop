<launch>
  <!-- Example launch file showing the main parameters exposed by the driver. -->
  <!-- Ports / device SN are auto-handled by SDK discovery, no need to configure them. -->
  <arg name="start_rviz" default="true"/>
  <arg name="rviz_config" default="$(find odin_ros_driver_rev1)/rviz/driver_view_ros1.rviz"/>
  <!-- Image resolution: 0 = use first capability from device -->
  <arg name="image_width" default="0"/>
  <arg name="image_height" default="0"/>
  <arg name="image_fps" default="0"/>
  <arg name="image_format" default="mjpeg"/>
  <!-- Topic prefix base (default: "manifold") -->
  <!-- Final topic format: /{topic_prefix}/{model}/device{index}/ -->
  <arg name="topic_prefix" default="manifold"/>

  <node pkg="odin_ros_driver_rev1" type="odin_ros_driver_node" name="odin_ros_driver" output="screen">
    <param name="operating_mode" value="normal"/>
    <param name="image_width" value="$(arg image_width)"/>
    <param name="image_height" value="$(arg image_height)"/>
    <param name="image_fps" value="$(arg image_fps)"/>
    <param name="image_format" value="$(arg image_format)"/>
    <param name="topic_prefix" value="$(arg topic_prefix)"/>
    <param name="channel_config_file" value="control_command.yaml"/>
  </node>

  <node pkg="odin_ros_driver_rev1" type="post_process_node" name="postprocess" output="screen">
    <rosparam command="load" file="$(find odin_ros_driver_rev1)/config/control_command.yaml"/>
    <param name="topic_prefix" value="$(arg topic_prefix)"/>
  </node>

  <!-- Point cloud reprojection node. Enable/mode loaded from control_command.yaml. -->
  <node pkg="odin_ros_driver_rev1" type="pointcloud_reprojector_node"
        name="pointcloud_reprojector" output="screen">
    <param name="min_depth" value="0.1"/>
    <param name="max_depth" value="50.0"/>
    <param name="point_size" value="2"/>
    <param name="topic_prefix" value="$(arg topic_prefix)"/>
  </node>

  <!-- PointCloud -> depth map verification node. -->
  <!-- Publishes /{prefix}/{model}/device{N}/pointcloud2depth/{depth,depth_color,depth_overlay}. -->
  <node pkg="odin_ros_driver_rev1" type="pointcloud_to_depth_node"
        name="pointcloud_to_depth" output="screen">
    <param name="topic_prefix" value="$(arg topic_prefix)"/>
    <param name="scale" value="7.0"/>
    <param name="z_min" value="0.1"/>
    <param name="z_max" value="50.0"/>
    <param name="dilate_radius" value="1"/>
    <param name="use_z_buffer" value="false"/>
    <param name="edge_grad_threshold" value="0.75"/>
    <param name="vis_depth_min" value="0.1"/>
    <param name="vis_depth_max" value="5.0"/>
  </node>

  <group if="$(arg start_rviz)">
    <!-- Convert compressed JPEG packets into sensor_msgs/Image for RViz. -->
    <!-- <node pkg="image_transport"
          type="republish"
          name="odin_image_republish"
          args="compressed in:=/odin/image raw out:=/odin/image_raw"
          output="screen"/> -->

    <node pkg="rviz"
          type="rviz"
          name="odin_rviz"
          args="-d $(arg rviz_config)"
          output="screen"/>
  </group>
</launch>
