# pixi environments
.pixi/*
!.pixi/config.toml
**/.pixi/

# Python/native build products and local environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
.pytest_cache/
/install/
/log/
/.migration-baseline/
/logs/migration-baseline/
/src/teleop_outputs/wuji/wuji_retargeting/wuji_retargeting/_native*.so
/src/teleop_inputs/exoskeleton/src/data_glove_wuji_teleop/_native*.so

# Preserved local environments/recordings from before the source cutover.
# No source or runtime launcher consumes these directories.
/TJ_arm_control-feature-pico-manus-teleop/
/PICO_tracker-feature-pico-manus-teleop/
/wuji-retargeting/

# unpublished calibration state and raw captures
/profiles/*/pico/.draft/
/profiles/*/pico/.seed-*/
/profiles/*/.calibration.lock
/profiles/*/.pico-publication
/profiles/*/.*.tmp
/profiles/*/recordings/

# runtime diagnostics and raw hand recordings
MUJOCO_LOG.TXT
/src/teleop_inputs/manus/recordings/
/recordings/
/logs/real/
/dataset/
/dataset_jpeg50/
/logs/home/
/logs/pico-setup/

# Repository-owned exoskeleton runtime output (tracked device profiles stay in config).
/src/teleop_inputs/exoskeleton/.pixi-cache/
/src/teleop_inputs/exoskeleton/.coverage
/src/teleop_inputs/exoskeleton/dist/
/src/teleop_inputs/exoskeleton/data/records/
/src/teleop_inputs/exoskeleton/config/dataglove/calibration/*_local.json
/src/teleop_inputs/exoskeleton/config/dataglove/calibration/*.backup.json
/src/teleop_inputs/exoskeleton/config/dataglove/devices/*.bak/

